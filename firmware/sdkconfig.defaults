# BLE stack: NimBLE (Bluedroid 不支持 BLE L2CAP CoC)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# BLE L2CAP CoC
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=1

# MSYS mbuf 池：单包最大 512 字节，共 30 个缓冲区
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=30
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_SIZE=512

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# 自定义分区表（含 model 分区用于 WakeNet9）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ESP-SR WakeNet 配置（使用真实人声训练的 hilexin 模型，支持自然发音 "嗨，乐鑫"）
# CONFIG_SR_WN_WN9_JARVIS_TTS is not set
# CONFIG_SR_WN_WN9S_HILEXIN is not set
CONFIG_SR_WN_WN9_HILEXIN=y

# PSRAM（OPI PSRAM @ 80MHz，ESP32-S3-BOX-Lite 8MB）
# AFE ring buffer / WakeNet inference 需要 PSRAM，否则内部 SRAM 不足
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# malloc 优先用内部 SRAM（<= 16KB），较大的分配走 PSRAM
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
