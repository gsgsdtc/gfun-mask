# 服务
SERVER_HOST=0.0.0.0
SERVER_PORT=8765

# ═══════════════════════════════════════════════════════════════
# LLM 提供商选择: dashscope | lmstudio
# ═══════════════════════════════════════════════════════════════
LLM_PROVIDER=lmstudio

# ═══════════════════════════════════════════════════════════════
# 配置 A: 阿里云 DashScope（STT/TTS 必需，LLM 可选）
# ═══════════════════════════════════════════════════════════════
# 阿里云 DashScope API Key（STT / TTS 必需，LLM 可选）
# 控制台获取：https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-aa47f65213a246e3a137ed2d6ed86082

# STT：阿里云 Paraformer 语音识别
STT_MODEL=paraformer-realtime-v2  # 实时识别模型，用 Recognition.call() 批量识别 < 1s

# LLM：通义千问（当 LLM_PROVIDER=dashscope 时使用）
LLM_MODEL=qwen-turbo-latest      # qwen-turbo（快速低成本） | qwen-plus | qwen-max

# TTS：阿里云 CosyVoice 语音合成
TTS_MODEL=cosyvoice-v1
TTS_VOICE=longxiaochun            # longxiaochun（女声） | longshuo（男声） | longyue

# ═══════════════════════════════════════════════════════════════
# 配置 B: LM Studio 本地模型（需要本地运行 LM Studio）
# ═══════════════════════════════════════════════════════════════
# 启动 LM Studio 并开启本地服务器（默认端口 1234）：
#   - 在 LM Studio 中加载模型
#   - 点击 "Start Server"
#   - 确认端口号为 1234

# LM Studio 本地 API 地址
LMSTUDIO_BASE_URL=http://localhost:1234/v1

# LM Studio API Key（默认无需验证，但 LM Studio 要求非空）
LMSTUDIO_API_KEY=lm-studio

# LM Studio 模型名称（LM Studio 会自动加载已选择的模型）
LMSTUDIO_MODEL=qwen3.5-4b-mlx

# ═══════════════════════════════════════════════════════════════
# 系统提示词（适用于所有 LLM 提供商）
# ═══════════════════════════════════════════════════════════════
LLM_SYSTEM_PROMPT=你是一个简洁友好的语音助手，直接给出回答不要展示思考过程，请用中文回答，每次回复不超过50字。
